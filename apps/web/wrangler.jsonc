// The private preview at conquerra.overconfidenceonline.com (docs/infra-cloudflare.md).
// The Worker serves the built web app as static files, and (session 26, M4) the online API under /api: one game room
// (a Durable Object) per online game, and a small database of accounts, games and seats.
// Deploy from the repo root with `pnpm deploy:preview` (after the one-time steps in the README).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conquerra",
  "account_id": "a3c440cb9c05c9f7f9007386e9c0f6c4",
  "compatibility_date": "2026-10-01",
  "main": "./server/index.ts",
  // No public address: no workers.dev URL and no preview URLs. The only way in is the custom domain, behind Access.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker's code; every other path is a static file, served as before.
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "conquerra.overconfidenceonline.com", "custom_domain": true }],
  // One room per online game: SQLite storage, an alarm for the turn clock, hibernating WebSockets.
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // Accounts, the list of online games and who sits where (migrations in ./migrations).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "conquerra_db",
      "database_id": "eed2c38b-1ca4-4e45-8b0b-b3c808183a6c",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    // Sign-in is Cloudflare Access: the Worker checks the token Access signs, for this team and this app.
    "ACCESS_TEAM": "keel-nkurtz.cloudflareaccess.com",
    // The Conquerra Access app's AUD tag (docs/infra-cloudflare.md, "Nate's steps"). Empty: online play is off.
    "ACCESS_AUD": ""
  },
  // Logs (and each request's CPU time) in the dashboard and `wrangler tail`.
  "observability": { "enabled": true }
}
