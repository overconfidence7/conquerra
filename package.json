{
  "name": "conquerra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p apps/web/server",
    "sim": "tsx apps/sim/src/cli.ts",
    "build-maps": "pnpm --filter @conquerra/mapgen build-maps",
    "art:import": "pnpm --filter @conquerra/art run art-import",
    "sound:import": "pnpm --filter @conquerra/sound run sound-import",
    "map-check": "node apps/web/scripts/map-check.mjs",
    "map-thumbs": "tsx apps/web/scripts/map-thumbs.ts",
    "ui-check": "node apps/web/scripts/ui-check.mjs",
    "deploy:preview": "node apps/web/scripts/clean-tree.mjs && pnpm test && pnpm build && node apps/web/scripts/bundle-size.mjs && wrangler d1 migrations apply conquerra_db --remote --config apps/web/wrangler.jsonc && wrangler deploy --config apps/web/wrangler.jsonc && node apps/web/scripts/check-preview.mjs",
    "check:preview": "node apps/web/scripts/check-preview.mjs",
    "bundle-size": "node apps/web/scripts/bundle-size.mjs",
    "tournament": "tsx apps/sim/src/tournament.ts",
    "server-maps": "node apps/web/scripts/server-maps.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.0",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.147.0"
  }
}
